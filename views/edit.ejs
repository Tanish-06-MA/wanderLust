<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%- include("partials/navbar") %>
    <main class="container">
        <section class="form-card">
            <h2>Edit listing</h2>
            <form method="POST" action="/listing/<%= list._id %>?_method=PUT" >
                <input type="text" name="Listing[title]" value="<%= list.title %>" placeholder="enter title">
                <span>Enter description:</span>
                <textarea name="Listing [description]"><%= list.description %></textarea>
                <input type="text" name="Listing[image]" value="<%= list.image %>" placeholder="Enter Image url">
                <input type="number" name="Listing[price]" value="<%= list.price %>" placeholder="Enter Price">
                <input type="text" name="Listing[location]" value="<%= list.location %>" placeholder="Enter location">
                <input type="text" name="Listing[country]" value="<%= list.country %>" placeholder="Enter country">
                <button>Save changes</button>
            </form>
        </section>
    </main>
</body>
</html>